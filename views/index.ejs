<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages</title>
</head>
<body>
    <h1>Message board</h1>

    <% messages.map(message => { %>
        <li> User: <%=message.user %> ,   Message: <%=message.text %>,   Time: <%=message.added %> </li>
    <% }) %>


</body>
</html>